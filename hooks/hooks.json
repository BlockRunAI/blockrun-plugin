{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__blockrun_.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/spend-gate.js\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__blockrun_.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/spend-tally.js\"" }
        ]
      }
    ]
  }
}
